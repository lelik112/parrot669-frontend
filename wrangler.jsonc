{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parrot669-frontend",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/recover",
      "/recover.html"
    ]
  }
}
